# Python cache files
__pycache__/
*.pyc

# Streamlit secrets file 
.streamlit/secrets.toml

# Ignore all content in the data/input directory...
data/input/*/*
# ...but DO NOT ignore the .gitkeep files inside, which preserves the folders
!data/input/*/.gitkeep

# Ignore all content in the data/output directory...
data/output/*/*
# ...but DO NOT ignore the .gitkeep files inside
!data/output/*/.gitkeep

# Environment folders
.venv/
venv/
env/
# Evaluation EPD PDFs are not redistributed with the repository; their
# provenance is recorded in eval/fixtures/manifest.json instead.
eval/fixtures/epds/*
!eval/fixtures/epds/.gitkeep

# Individual evaluation run records (they embed extracted EPD content)
eval/results/
